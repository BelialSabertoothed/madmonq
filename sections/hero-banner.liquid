<div class="hero-banner-wrapper">
  <div class="hero-banner" style="--bg-image: url('{{ "hero-banner.png" | asset_url }}');">
    <div class="hero-banner__rays" style="background-image: url('{{ "Rays8.png" | asset_url }}');"></div>
    
    <div class="hero-banner__inner">
      <div class="hero-banner__content">
        <div class="hero-banner__subtitle">
          MADMONQ<sup>®</sup> <span class="hero-banner__subtitle-separator">/</span>
          <span class="hero-banner__subtitle-light">BEST FOCUS SUPPLEMENT</span>
        </div>

        <h1 class="hero-banner__heading">
          <span class="hero-banner__heading-white">{{ section.settings.heading_line_1 }}</span><br>
          <span class="hero-banner__heading-purple">{{ section.settings.heading_line_2 }}</span>
        </h1>

        <a href="{{ section.settings.button_link }}" class="hero-banner__button">
          {{ 'icon_shape.svg' | inline_asset_content }}
          {{ section.settings.button_label }}
        </a>
      </div>

      <div class="hero-banner__footer">
        <div class="hero-banner__features">
          <div class="feature-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            VERSION 5.0 IS HERE
          </div>

          <div class="feature-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            RESIDENTSLEEPER BUNDLE
          </div>
          
          <div class="feature-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            MONQ FLASK GIFT
          </div>
        </div>

        <div class="hero-banner__reviews">
          <div class="reviews-text">
            <div class="reviews-score">
              4.84
              {{ 'star.svg' | inline_asset_content }}
              10K REVIEWS
            </div>
            <div class="reviews-sub">Trusted by thousands of verified users</div>
          </div>
          <div class="reviews-avatars">
            <div class="avatar-circle" style="background-image: url('{{ 'avatar2.png' | asset_url }}');"></div>
            <div class="avatar-circle" style="background-image: url('{{ 'avatar3.png' | asset_url }}');"></div>
            <div class="avatar-circle" style="background-image: url('{{ 'avatar1.png' | asset_url }}');"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="hero-banner__highlight-line"></div>
</div>

{% stylesheet %}
  .hero-banner-wrapper {
    position: relative;
    width: 82%;
    max-width: var(--page-width);
    margin: 2rem auto;
    border-radius: 32px; 
    padding: 2px; 
    background: linear-gradient(150deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.4) 30%, rgba(255, 255, 255, 0.05) 60%, rgba(255, 255, 255, 0.3) 100%);
  }

  .hero-banner {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    position: relative;
    overflow: hidden; 
    background-color: #000015;
    background-image: linear-gradient(to top, rgba(0, 0, 21, 0.62) 0%, rgba(0, 0, 21, 0) 200px),
      linear-gradient(to right, rgba(0, 0, 21, 1) 0%, rgba(0, 0, 21, 1) 20%, rgba(0, 0, 21, 0) 40%), var(--bg-image);
    background-size: cover, cover, 105%;
    background-position: bottom center, left center, -300% 30%;
    background-repeat: no-repeat, no-repeat, no-repeat;
    box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.5); 
  }

  .hero-banner__rays {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.25;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 1;
  }

 .hero-banner__highlight-line {
    position: absolute;
    bottom: 0; 
    left: 15%;
    width: clamp(100px, 15vw, 200px);
    height: 2px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 50%, rgba(255, 255, 255, 0) 100%);
    box-shadow: 0 0 4px 1px rgba(255, 255, 255, 0.7); 
    z-index: 10;
    pointer-events: none;
  }

  .hero-banner__inner {
    padding: clamp(80px, 10vw, 160px) clamp(24px, 8%, 118px) 40px;
    min-height: clamp(400px, 60vh, 600px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .hero-banner__content {
    z-index: 2;
    max-width: clamp(320px, 60%, 600px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-banner__heading {
    font-family: 'Vanguard CF', var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 80px);
    line-height: 0.96;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .hero-banner__subtitle {
    font-size: clamp(0.7rem, 0.8vw, 0.85rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #a0a0a0;
    margin-bottom: 1.2rem;
    font-family: var(--font-primary--family), sans-serif;
  }

  .hero-banner__button {
    padding: clamp(10px, 1.5vw, 16px) clamp(20px, 3vw, 32px);
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    background-color: var(--color-accent);
    color: #ffffff;
    border-radius: 50px;
    text-decoration: none;
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: transform 0.2s ease, background-color 0.2s ease;
    width: fit-content;
  }

  .hero-banner__subtitle-separator {
    margin: 0 0.5rem;
    color: #555;
  }

  .hero-banner__subtitle-light {
    color: #777;
    font-weight: 500;
  }

  .hero-banner__heading-white {
    color: #ffffff;
  }

  .hero-banner__heading-purple {
    color: var(--color-accent);
  }

  .hero-banner__button:hover {
    transform: translateY(-2px);
    background-color: #9a83e6;
  }

  .hero-banner__button svg {
    fill: currentColor;
    width: clamp(16px, 2.5vw, 24px);
  }

  .hero-banner__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(30px, 5vw, 60px);
    padding-top: 20px;
    z-index: 2;
    gap: 1.5rem;
  }

  .hero-banner__features {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: clamp(0.6rem, 0.8vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.3;
    transition: opacity 0.2s ease;
  }

  .feature-item:first-child {
    opacity: 1;
  }

  .hero-banner__reviews {
    display: flex;
    align-items: center;
    gap: 1rem;
    align-self: center;
  }

  .reviews-text {
    text-align: right;
  }

  .reviews-score {
    color: #ffffff;
    font-weight: 700;
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-family: var(--font-heading--family), sans-serif;
  }

  .reviews-score svg {
    width: 1em;
    height: 1em;
  }

  .reviews-sub {
    color: #ffffff;
    font-size: clamp(0.6rem, 0.8vw, 0.75rem);
    margin-top: 2px;
  }

  .reviews-avatars {
    display: flex;
  }

  .avatar-circle {
    width: clamp(24px, 3vw, 32px);
    height: clamp(24px, 3vw, 32px);
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    margin-left: -12px;
    position: relative;
    z-index: 1;
  }

  .avatar-circle:first-child {
    margin-left: 0;
    z-index: 3;
  }

  .avatar-circle:nth-child(2) {
    z-index: 2;
  }

  @media screen and (max-width: 1024px) {
    .hero-banner-wrapper {
      width: 90%;
    }
    .hero-banner {
      background-position: center, -200% center;
    }
    .hero-banner__footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .reviews-text {
      text-align: left;
    }
    .reviews-score {
      justify-content: flex-start;
    }
    .hero-banner__reviews {
      align-self: flex-start;
    }
  }

  @media screen and (max-width: 768px) {
    .hero-banner-wrapper {
      width: 95%;
    }
    .hero-banner {
      background-position: center, 75% center;
    }
    .hero-banner__heading {
      line-height: 1;
    }
    .hero-banner__features {
      flex-direction: column;
      gap: 1rem;
    }
    .hero-banner__inner {
      padding: clamp(60px, 15vw, 120px) 20px 20px 20px;
    }
    .hero-banner__button {
      width: 100%;
      justify-content: center;
    }
    .hero-banner__button svg {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1 (White)",
      "default": "YOU CAN'T PERFORM"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading Line 2 (Purple)",
      "default": "WITHOUT FOCUS."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "BUY MADMONQ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
