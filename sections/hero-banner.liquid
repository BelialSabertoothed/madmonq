<div class="hero-banner-wrapper">
  <div class="hero-banner" style="--bg-image: url('{{ "hero-banner.png" | asset_url }}');">
    <div class="hero-banner__rays" style="background-image: url('{{ "Rays8.png" | asset_url }}');"></div>

    <div class="hero-banner__inner">
      <div class="hero-banner__content">
        <div class="hero-banner__subtitle">
          MADMONQ<sup>®</sup> <span class="hero-banner__subtitle-separator">/</span>
          <span class="hero-banner__subtitle-light">BEST FOCUS SUPPLEMENT</span>
        </div>

        <h1 class="hero-banner__heading">
          <span class="hero-banner__heading-white">{{ section.settings.heading_line_1 }}</span><br>
          <span class="hero-banner__heading-purple">{{ section.settings.heading_line_2 }}</span>
        </h1>

        <div class="hero-banner__actions">
          <a href="{{ section.settings.button_link }}" class="hero-banner__button">
            {{ 'icon_shape.svg' | inline_asset_content }}
            {{ section.settings.button_label }}
          </a>

          <div class="hero-banner__reviews-mobil">4.84 {{ 'star.svg' | inline_asset_content }}</div>
        </div>
      </div>

      <div class="hero-banner__footer">
        <div class="hero-banner__stories-desktop">
          <div class="story-item is-highlighted" data-story-index="0">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            VERSION 5.0 IS HERE
          </div>
          <div class="story-item" data-story-index="1">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            RESIDENTSLEEPER BUNDLE
          </div>
          <div class="story-item" data-story-index="2">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            MONQ FLASK GIFT
          </div>
        </div>

        <div class="hero-banner__reviews-desktop">
          <div class="reviews-text">
            <div class="reviews-score">4.84 {{ 'star.svg' | inline_asset_content }} 10K REVIEWS</div>
            <div class="reviews-sub">Trusted by thousands of verified users</div>
          </div>
          <div class="reviews-avatars">
            <div class="avatar-circle" style="background-image: url('{{ "avatar2.png" | asset_url }}');"></div>
            <div class="avatar-circle" style="background-image: url('{{ "avatar3.png" | asset_url }}');"></div>
            <div class="avatar-circle" style="background-image: url('{{ "avatar1.png" | asset_url }}');"></div>
          </div>
        </div>
      </div>

      <div class="hero-banner__stories-mobil-wrapper">
        <div class="hero-banner__stories-mobil">
          <span class="story-segment is-highlighted" data-story-index="0"></span>
          <span class="story-segment" data-story-index="1"></span>
          <span class="story-segment" data-story-index="2"></span>
          <span class="story-segment" data-story-index="3"></span>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner-wrapper {
    position: relative;
    width: 82%;
    max-width: var(--page-width);
    margin: 2rem auto;
    border-radius: 32px;
    padding: 1px;
    z-index: 10;

    background: radial-gradient(ellipse 350px 2px at 30% 0%, rgba(255, 255, 255, 0.7) 0%, transparent 100%),
      radial-gradient(ellipse 400px 3px at 15% 100%, rgba(255, 255, 255, 1) 0%, transparent 100%),
      radial-gradient(circle 80px at 0% 100%, rgba(255, 255, 255, 0.5) 0%, transparent 100%), rgba(255, 255, 255, 0.04);
  }

  @media screen and (min-width: 769px) {
    .hero-banner {
      width: 100%;
      height: 100%;
      border-radius: 31px;
      position: relative;
      overflow: hidden;
      background-color: #000015;
      background-image: linear-gradient(to top, rgba(0, 0, 21, 0.62) 0%, rgba(0, 0, 21, 0) 200px),
        linear-gradient(to right, rgba(0, 0, 21, 1) 0%, rgba(0, 0, 21, 1) 20%, rgba(0, 0, 21, 0) 40%), var(--bg-image);
      background-size: cover, cover, 105%;
      background-position: bottom center, left center, -300% 30%;
      background-repeat: no-repeat, no-repeat, no-repeat;

      box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.5), -5px 10px 40px rgba(255, 255, 255, 0.15);
    }
  }

  .hero-banner__rays {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.25;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 1;
  }

  .hero-banner__inner {
    padding: clamp(80px, 10vw, 160px) clamp(24px, 8%, 118px) 40px;
    min-height: clamp(400px, 60vh, 600px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
    z-index: 5;
  }

  .hero-banner__content {
    z-index: 2;
    max-width: clamp(320px, 60%, 600px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-banner__heading {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .hero-banner__subtitle {
    font-size: clamp(0.7rem, 0.8vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #ffffff;
    opacity: 0.5;
    margin-bottom: 1.2rem;
  }
  .hero-banner__subtitle-separator {
    margin: 0 0.5rem;
    color: #ffffff;
    opacity: 0.5;
  }
  .hero-banner__heading-white {
    color: #ffffff;
  }
  .hero-banner__heading-purple {
    color: var(--color-accent);
  }

  .hero-banner__actions {
    margin-top: 0.5em;
    width: 100%;
  }
  .hero-banner__reviews-mobil,
  .hero-banner__stories-mobil-wrapper {
    display: none;
  }

  .hero-banner__button {
    padding: clamp(8px, 1vw, 16px) clamp(16px, 2vw, 24px);
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    background-color: var(--color-accent);
    color: #ffffff;
    border-radius: 32px;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -5%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transition: transform 0.2s ease, filter 0.2s ease;
    width: fit-content;
  }
  .hero-banner__button:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .hero-banner__button svg {
    fill: currentColor;
    width: clamp(10px, 2vw, 18px);
  }

  .hero-banner__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(30px, 5vw, 60px);
    padding-top: 5em;
    padding-bottom: 1em;
    z-index: 2;
    gap: 1.5rem;
  }

  .hero-banner__stories-desktop {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .story-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-size: clamp(0.6rem, 0.8vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
  }
  .story-item:hover {
    transform: translateY(-2px);
    opacity: 0.8;
  }
  .story-item.is-highlighted {
    opacity: 1;
  }

  .hero-banner__reviews-desktop {
    display: flex;
    align-items: center;
    gap: 1rem;
    align-self: center;
  }
  .reviews-text {
    text-align: right;
  }
  .reviews-score {
    color: #ffffff;
    font-weight: 700;
    font-size: clamp(0.8rem, 1.2vw, 1rem);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }
  .reviews-score svg {
    width: 1em;
    height: 1em;
  }
  .reviews-sub {
    color: #ffffff;
    font-size: clamp(0.6rem, 0.8vw, 0.75rem);
    margin-top: 2px;
  }

  .reviews-avatars {
    display: flex;
  }
  .avatar-circle {
    width: clamp(24px, 3vw, 32px);
    height: clamp(24px, 3vw, 32px);
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    margin-left: -12px;
    position: relative;
    z-index: 1;
    border: 1px solid #000;
  }
  .avatar-circle:first-child {
    margin-left: 0;
    z-index: 3;
  }
  .avatar-circle:nth-child(2) {
    z-index: 2;
  }

  @media screen and (max-width: 1024px) {
    .hero-banner-wrapper {
      width: 90%;
    }
  }

  @media screen and (max-width: 768px) {
    .hero-banner-wrapper {
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(-50vw + 50%);
      margin-top: -30px;
      padding: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .hero-banner {
      border-radius: 0;
      box-shadow: none;
      background-image: linear-gradient(to top, rgba(0, 0, 21, 1) 0%, rgba(0, 0, 21, 0) 45%), var(--bg-image);
      background-size: 250% auto;
      background-position: bottom center, center;
      background-repeat: no-repeat;
      height: auto;
      min-height: 85vh;
    }

    .hero-banner__rays {
      display: none;
    }
    .hero-banner__footer {
      display: none;
    }

    .hero-banner__inner {
      padding: 60px 20px 40px 20px;
      justify-content: flex-end;
      min-height: 85vh;
    }

    .hero-banner__content {
      max-width: 100%;
    }

    .hero-banner__heading {
      margin-bottom: 0;
    }
    .hero-banner__subtitle {
      margin-bottom: 0;
    }

    .hero-banner__actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      margin-top: 1.5rem;
    }

    .hero-banner__button {
      margin-top: 0;
      padding: 12px 24px;
    }

    .hero-banner__reviews-mobil {
      display: flex;
      align-items: center;
      gap: 5px;
      color: #ffffff;
      font-weight: 700;
      font-size: 1rem;
      font-family: var(--font-heading--family), sans-serif;
    }
    .hero-banner__reviews-mobil svg {
      width: 1em;
      height: 1em;
      fill: currentColor;
    }

    .hero-banner__stories-mobil-wrapper {
      display: block;
      width: 100%;
      margin-top: 30px;
      margin-bottom: 10px;
      z-index: 5;
    }

    .hero-banner__stories-mobil {
      display: flex;
      width: 100%;
      justify-content: space-between;
      gap: 6px;
      box-sizing: border-box;
    }

    .story-segment {
      display: block;
      flex: 1 1 0;
      height: 6px;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 3px;
      transition: background 0.3s ease;
      cursor: pointer;
    }

    .story-segment.is-highlighted {
      background: #ffffff;
    }
  }

  .hero-banner__subtitle,
  .hero-banner__button,
  .story-item,
  .reviews-score {
    font-family: var(--font-heading--family), sans-serif;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1 (White)",
      "default": "YOU CAN'T PERFORM"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading Line 2 (Purple)",
      "default": "WITHOUT FOCUS."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "BUY MADMONQ"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('click', function (e) {
    const target = e.target.closest('.story-item') || e.target.closest('.story-segment');

    if (!target) return;

    const index = target.getAttribute('data-story-index');
    if (index !== null) {
      document.querySelectorAll('.story-item, .story-segment').forEach((el) => {
        el.classList.remove('is-highlighted');
      });

      document
        .querySelectorAll(`.story-item[data-story-index="${index}"], .story-segment[data-story-index="${index}"]`)
        .forEach((el) => {
          el.classList.add('is-highlighted');
        });
    }
  });
</script>
