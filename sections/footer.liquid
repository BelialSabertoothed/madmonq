{% stylesheet %}
  .footer {
    background-color: #000000;
    color: #ffffff;
    font-family: var(--font-heading--family), sans-serif;
    padding: 60px var(--page-margin) 40px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  
  .footer__inner {
      width: clamp(72%, 60vw, 1285px);
      max-width: 1285px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }
  
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  .footer__logo {
    height: 32px;
    width: auto;
  }
  
  .footer__links-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .footer__col a {
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  
  .footer__col a:hover {
    opacity: 1;
  }
  
  .footer__middle {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  .newsletter-form {
    display: flex;
    align-items: center;
    background: #111116;
    border-radius: 8px;
    padding: 12px 16px;
    gap: 12px;
  }
  
  .newsletter-form input {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    flex: 1;
    outline: none;
    font-family: var(--font-heading--family), sans-serif;
  }
  
  .newsletter-form input::placeholder {
    color: rgba(255,255,255,0.5);
  }
  
  .newsletter-form button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  
  .footer__socials {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  
  .footer__socials a {
    color: #ffffff;
    opacity: 0.5;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
  }
  
  .footer__socials a:hover {
    opacity: 1;
  }
  
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  
  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
  }
  
  .footer__legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .footer__legal a:hover {
    color: rgba(255,255,255,0.8);
  }
  
  .footer__lang {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  
  @media screen and (min-width: 1024px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
    }
    
    .footer__links-container {
      grid-template-columns: repeat(4, auto);
      gap: 64px;
    }
    
    .footer__middle {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    
    .footer__newsletter {
      width: 320px;
    }
    
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    
    .footer__legal {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }
  }
{% endstylesheet %}

