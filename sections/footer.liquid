<footer class="footer full-width">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}">
          <img
            src="{{ 'madmonq_logo.svg' | asset_url }}"
            alt="MADMONQ"
            width="160"
            height="32"
            loading="lazy"
            class="footer__logo"
          >
        </a>
      </div>

      <div class="footer__links-container">
        <div class="footer__links-group">
          <div class="footer__col col-blog">
            <a href="#">BLOG</a>
            <a href="#">2030 MISSION</a>
            <a href="#">CAREERS</a>
            <a href="#">AFFILIATE</a>
          </div>
          <div class="footer__col col-about">
            <a href="#">ABOUT US</a>
            <a href="#">SCIENCE</a>
            <a href="#">RETURN POLICY</a>
            <a href="#">VIP MASTER CLASS</a>
            <a href="#">REVIEWS</a>
          </div>
        </div>

        <div class="footer__links-group">
          <div class="footer__col col-home">
            <a href="#">HOMEPAGE</a>
            <a href="#">PRODUCTS</a>
            <a href="#">MERCH</a>
            <a href="#">FAQ</a>
            <a href="#">CONTACT</a>
          </div>
          <div class="footer__col col-contact">
            <a href="mailto:team@madmonq.gg">TEAM@MADMONQ.GG</a>
            <a href="mailto:gdpr@madmonq.gg">GDPR@MADMONQ.GG</a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer__middle">
      <div class="footer__newsletter">
        <form class="newsletter-form" action="#">
          <img src="{{ 'icon_mail.svg' | asset_url }}" class="icon-mail" alt="Mail" width="24" height="24">
          <input type="email" placeholder="NEWSLETTER" required>
          <button type="submit">
            <img
              src="{{ 'icon_arrowRight.svg' | asset_url }}"
              class="icon-arrow-right"
              alt="Submit"
              width="18"
              height="18"
            >
          </button>
        </form>
      </div>

      <div class="footer__socials">
        <a href="#" aria-label="Facebook"
          ><img src="{{ 'icon_facebook.svg' | asset_url }}" alt="Facebook" width="20" height="20"
        ></a>
        <a href="#" aria-label="Twitter"
          ><img src="{{ 'icon_twitter.svg' | asset_url }}" alt="Twitter" width="20" height="20"
        ></a>
        <a href="#" aria-label="Twitch"
          ><img src="{{ 'icon_twitch.svg' | asset_url }}" alt="Twitch" width="20" height="20"
        ></a>
        <a href="#" aria-label="YouTube"
          ><img src="{{ 'icon_youtube.svg' | asset_url }}" alt="YouTube" width="20" height="20"
        ></a>
        <a href="#" aria-label="X"
        ><img src="{{ 'icon_x.svg' | asset_url }}" alt="X" width="20" height="20"></a>
        <a href="#" aria-label="Instagram"
          ><img src="{{ 'icon_instagram.svg' | asset_url }}" alt="Instagram" width="20" height="20"
        ></a>
        <a href="#" aria-label="TikTok"
          ><img src="{{ 'icon_tiktok.svg' | asset_url }}" alt="TikTok" width="20" height="20"
        ></a>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <span class="copyright">MADMONQ&copy; COPYRIGHT 2025. ALL RIGHTS RESERVED</span>
        <a href="#">PRIVACY</a>
        <a href="#">COOKIE POLICY</a>
        <a href="#">TERMS & CONDITIONS</a>
      </div>

      <div class="footer__lang">
        <a href="#" aria-label="Globe"
          ><img src="{{ 'icon_globe.svg' | asset_url }}" alt="Globe" width="20" height="20"
        ></a>
        ENGLISH
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: #000000;
    color: #52545c;
    font-weight: 500;
    font-family: var(--font-heading--family), sans-serif;
    padding: 60px 0 40px;
  }

  .footer__inner {
    width: 72%;
    max-width: 1285px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .footer__logo {
    height: 40px;
    width: auto;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__col a {
    color: #52545c;
    font-weight: 500;
    font-size: clamp(12px, 1vw, 15px);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s, filter 0.2s;
  }

  .footer__col a:hover {
    color: #ffffff;
  }

  .footer__middle {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 0;
    border-width: 1px 0px 1px 0px;
    border-style: solid;
    border-color: #656a8340;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    background: #111116;
    border-radius: 8px;
    padding: 12px 16px;
    gap: 12px;
    width: 100%;
  }

  .newsletter-form input {
    background: transparent;
    border: none;
    color: #52545c;
    font-weight: 500;
    font-size: clamp(12px, 1vw, 15px);
    flex: 1;
    outline: none;
    font-family: var(--font-heading--family), sans-serif;
  }

  .newsletter-form input::placeholder {
    color: #52545c;
    opacity: 0.7;
  }

  .newsletter-form button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .icon-arrow-right {
    height: 18px;
  }

  .footer__socials {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .footer__socials a {
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: filter 0.2s;
  }

  .footer__socials a:hover {
    filter: brightness(1.5);
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: clamp(12px, 1vw, 15px);
    color: #52545c;
  }

  .footer__legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__legal a:hover {
    color: #ffffff;
  }

  .footer__lang {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #52545c;
    font-size: clamp(12px, 1vw, 15px);
    cursor: pointer;
  }

  @media screen and (max-width: 1023px) {
    .footer__top,
    .footer__bottom {
      display: contents;
    }

    .footer__brand {
      order: 1;
      margin-bottom: 40px;
    }

    .footer__links-container {
      order: 2;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      margin-bottom: 40px;
    }

    .footer__links-group {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .col-contact {
      margin-top: 2.15rem;
    }

    .footer__middle {
      order: 3;
      margin-bottom: 32px;
    }

    .footer__legal {
      order: 4;
    }

    .footer__lang {
      order: 5;
      margin-top: 24px;
    }
  }

  @media screen and (min-width: 1024px) {
    .footer__top {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }

    .footer__links-container {
      display: grid;
      grid-template-columns: repeat(4, auto);
      gap: 64px;
    }

    .footer__links-group {
      display: contents;
    }

    .col-blog {
      order: 1;
    }
    .col-home {
      order: 2;
    }
    .col-about {
      order: 3;
    }
    .col-contact {
      order: 4;
      margin-top: 0;
    }

    .footer__middle {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin: 40px 0;
    }

    .footer__newsletter {
      width: 320px;
    }

    .footer__bottom {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .footer__legal {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }
  }
{% endstylesheet %}

