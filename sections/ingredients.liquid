<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '#shopify-section-{{ section.id }}';
    const grid = document.querySelector(`${sectionId} .ingredient-carousel-grid`);
    const nextBtn = document.querySelector(`${sectionId} .carousel-btn-next`);
    const containers = document.querySelectorAll(`${sectionId} .ingredient-container`);

    // Přepínání hlavních karet (krokový carousel)
    if (nextBtn && grid) {
      nextBtn.addEventListener('click', function () {
        const firstCard = grid.querySelector('.ingredient-container');
        if (firstCard) {
          const gap = parseFloat(window.getComputedStyle(grid).gap) || 40;
          const scrollAmount = firstCard.offsetWidth + gap;
          grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      });
    }

    const observerOptions = {
      root: grid,
      rootMargin: '0px',
      threshold: 0.55,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-active');
        } else {
          entry.target.classList.remove('is-active');
        }
      });
    }, observerOptions);

    containers.forEach((container) => observer.observe(container));

    // Logika pro mini slider v obrázku produktu
    const imageCarousels = document.querySelectorAll(`${sectionId} .ingredient-image-wrapper`);
    imageCarousels.forEach((wrapper) => {
      const track = wrapper.querySelector('.product-carousel-track');
      const dots = wrapper.querySelectorAll('.product-carousel-dots .dot');

      if (track && dots.length > 0) {
        track.addEventListener('scroll', () => {
          const slideWidth = track.clientWidth;
          const index = Math.round(track.scrollLeft / slideWidth);
          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === index);
          });
        });

        dots.forEach((dot, i) => {
          dot.addEventListener('click', () => {
            track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
          });
        });
      }
    });
  });
</script>
