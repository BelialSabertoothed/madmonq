{{ 'section-ingredients.css' | asset_url | stylesheet_tag }}

<div class="ingredient-section" style="--bg-wave: url('{{ 'image_131.png' | asset_url }}');">
  <div class="carousel-wrapper">
    <div class="ingredient-carousel-grid">
      {%- assign card_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          {%- assign card_count = card_count | plus: 1 -%}

          <div class="ingredient-container{% if card_count == 1 %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="ingredient-content">
              {%- if block.settings.subtitle != blank -%}
                <span class="ingredient-subtitle">{{ block.settings.subtitle }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2 class="h2 headline-color">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ingredient-desc">
                  {{ block.settings.description | newline_to_br }}
                </p>
              {%- endif -%}

              <div class="ingredients-header">
                <span class="ingredients-title">
                  {%- if block.settings.ingredients_title_icon != blank -%}
                    {{
                      block.settings.ingredients_title_icon
                      | image_url: width: 50
                      | image_tag: class: 'header-custom-icon', loading: 'lazy', alt: 'Icon'
                    }}
                  {%- endif -%}
                  {{ block.settings.ingredients_title }}
                </span>
                <span class="ingredients-clinical">
                  {%- if block.settings.ingredients_subtitle_icon != blank -%}
                    {{
                      block.settings.ingredients_subtitle_icon
                      | image_url: width: 50
                      | image_tag: class: 'header-custom-icon', loading: 'lazy', alt: 'Icon'
                    }}
                  {%- endif -%}
                  {{ block.settings.ingredients_subtitle }}
                </span>
              </div>

              <div class="ingredients-grid">
                {%- for i in (1..4) -%}
                  {%- assign ing_icon_key = 'ing_' | append: i | append: '_icon' -%}
                  {%- assign ing_name_key = 'ing_' | append: i | append: '_name' -%}
                  {%- assign ing_icon = block.settings[ing_icon_key] -%}
                  {%- assign ing_name = block.settings[ing_name_key] -%}

                  {%- if ing_name != blank or ing_icon != blank -%}
                    <div class="ingredient-item">
                      {%- if ing_icon -%}
                        {{
                          ing_icon
                          | image_url: width: 150
                          | image_tag: class: 'ingredient-icon', loading: 'lazy', alt: ing_name
                        }}
                      {%- endif -%}
                      {%- if ing_name != blank -%}
                        <span class="ingredient-name">{{ ing_name }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="ingredient-actions">
                {%- if block.settings.button_text != blank -%}
                  <a href="{{ block.settings.button_link }}" class="buy-button">
                    {%- if block.settings.button_icon != blank -%}
                      {{
                        block.settings.button_icon
                        | image_url: width: 40
                        | image_tag: class: 'btn-icon', loading: 'lazy', alt: 'Button Icon'
                      }}
                    {%- endif -%}
                    {{ block.settings.button_text }}
                  </a>
                {%- endif -%}

                <div class="reviews">
                  <div class="stars">{{ block.settings.reviews_stars }}</div>
                  <span>{{ block.settings.reviews_text }}</span>
                </div>
                <div class="reviewer-avatars">
                  <div class="reviewer-circle" style="background-image: url('{{ "reviewer.png" | asset_url }}');"></div>
                  <div
                    class="reviewer-circle"
                    style="background-image: url('{{ "reviewer2.png" | asset_url }}');"
                  ></div>
                  <div
                    class="reviewer-circle"
                    style="background-image: url('{{ "reviewer3.png" | asset_url }}');"
                  ></div>
                </div>
              </div>
            </div>

            <div class="ingredient-image-wrapper">
              <div class="product-image-carousel">
                <div class="product-carousel-track">
                  {%- for j in (1..4) -%}
                    {%- assign m_img_key = 'main_image_' | append: j -%}
                    {%- assign m_img = block.settings[m_img_key] -%}
                    {%- if m_img != blank -%}
                      <div class="product-carousel-slide">
                        {{
                          m_img
                          | image_url: width: 1000
                          | image_tag: class: 'main-product-image', loading: 'lazy', alt: 'Product image'
                        }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- assign dot_count = 0 -%}
                {%- for j in (1..4) -%}
                  {%- assign m_img_key = 'main_image_' | append: j -%}
                  {%- if block.settings[m_img_key] != blank -%}
                    {%- assign dot_count = dot_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if dot_count > 1 -%}
                  <div class="product-carousel-dots">
                    {%- for j in (1..dot_count) -%}
                      <button class="dot{% if forloop.first %} active{% endif %}" aria-label="Slide {{ j }}"></button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>

              {%- if block.settings.badge_icon != blank or block.settings.badge_text != blank -%}
                <div class="product-badge-corner">
                  {%- if block.settings.badge_icon != blank -%}
                    {{
                      block.settings.badge_icon
                      | image_url: width: 60
                      | image_tag: class: 'badge-icon', loading: 'lazy', alt: 'Badge'
                    }}
                  {%- endif -%}
                  {%- if block.settings.badge_text != blank -%}
                    <span class="badge-text">{{ block.settings.badge_text | newline_to_br }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="tags-container">
                {%- for i in (1..3) -%}
                  {%- assign tag_icon_key = 'tag_' | append: i | append: '_icon' -%}
                  {%- assign tag_text_key = 'tag_' | append: i | append: '_text' -%}
                  {%- assign tag_icon = block.settings[tag_icon_key] -%}
                  {%- assign tag_text = block.settings[tag_text_key] -%}

                  {%- if tag_text != blank -%}
                    <span class="tag">
                      {%- if tag_icon -%}
                        {{
                          tag_icon
                          | image_url: width: 50
                          | image_tag: class: 'tag-custom-icon', loading: 'lazy', alt: 'Icon'
                        }}
                      {%- endif -%}
                      {{ tag_text }}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if card_count > 1 -%}
      <button class="carousel-btn-next" aria-label="Posunout doprava">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {%- endif -%}
  </div>

  <div class="featured-on-container">
    {%- if section.settings.featured_title != blank -%}
      <div class="featured-title">{{ section.settings.featured_title }}</div>
    {%- endif -%}
    <div class="featured-logos-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'featured_logo' -%}
          <div class="featured-logo-item" {{ block.shopify_attributes }}>
            {%- if block.settings.logo_image != blank -%}
              {{
                block.settings.logo_image
                | image_url: width: 200
                | image_tag: class: 'featured-logo-img', loading: 'lazy', alt: 'Featured Logo'
              }}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

