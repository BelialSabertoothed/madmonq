<div class="mmq-hexacore-section" id="Section-{{ section.id }}">
  <div class="mmq-section-top-gradient"></div>

  <div class="mmq-section-inner">
    <div class="mmq-visuals-background">
      <div class="mmq-ellipse-glow-1"></div>
      <div class="mmq-ellipse-glow-2"></div>

      <div class="mmq-images-container">
        <img
          src="{{ 'Madm_Body_Neon0000 1.png' | asset_url }}"
          alt="Madmonq Neon"
          class="mmq-img-neon"
          loading="lazy"
          width="1000"
          height="800"
        >

        <img
          src="{{ 'Madm_Body_Champion0000 1.png' | asset_url }}"
          alt="Madmonq Champion"
          class="mmq-img-champion"
          width="800"
          height="1100"
          loading="lazy"
        >
      </div>
    </div>

    <div class="mmq-content-foreground">
      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <div class="mmq-main-heading-wrapper">
          <h2 class="h2">
            <span class="mmq-main-heading-white">{{ section.settings.heading_line_1 }}</span>
            <br>
            <span class="mmq-main-heading-gray">{{ section.settings.heading_line_2 }}</span>
          </h2>
        </div>
      {%- endif -%}

      <div class="mmq-cards-grid">
        {%- for block in section.blocks -%}
          <div class="mmq-hexacore-card" {{ block.shopify_attributes }}>
            <div class="mmq-card-icon-square">
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 120 }}"
                  class="mmq-card-main-icon"
                  alt="{{ block.settings.title | escape }}"
                  width="44"
                  height="44"
                  loading="lazy"
                >
              {%- endif -%}
            </div>

            <div class="mmq-card-content">
              <h3 class="mmq-card-title subtitle-1">{{ block.settings.title }}</h3>
              <p class="mmq-card-desc text-small">{{ block.settings.text }}</p>
            </div>

            {%- if block.settings.corner_icon != 'none' -%}
              <img
                src="{{ block.settings.corner_icon | asset_url }}"
                class="mmq-card-corner-icon"
                alt=""
                width="16"
                height="16"
                loading="lazy"
              >
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- assign footer_block = section.blocks | where: 'type', 'footer' | first -%}
      {%- if footer_block -%}
        <div class="footer-container" style="margin-top: 60px; display: flex; align-items: center; gap: 12px;">
          <img
            src="{{ 'hexacore.png' | asset_url }}"
            alt="hexacore"
            class="hexacore-image"
            width="24"
            height="24"
            loading="lazy"
          >
          <p class="mmq-footer-text text-small">{{ footer_block.settings.text }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .mmq-hexacore-section {
    position: relative;
    background-color: #08080a;
    width: 100%;
    overflow: visible;
    padding: 60px 20px 80px 20px;
    z-index: 100;
  }

  .mmq-section-top-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 250px;
    background: linear-gradient(to bottom, rgba(8, 8, 10, 0) 0%, #08080a 100%);
    transform: translateY(-100%);
    pointer-events: none;
    z-index: -1;
  }

  .mmq-section-inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    min-height: 900px;
    display: flex;
    align-items: flex-start;
  }

  .mmq-content-foreground {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 760px;
  }

  .mmq-main-heading-wrapper {
    margin-bottom: 56px;
    max-width: 900px;
  }

  .mmq-main-heading-white {
    color: #ffffff;
  }
  .mmq-main-heading-gray {
    color: #535353;
  }

  .mmq-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 18px;
    position: relative;
    z-index: 20;
  }

  .mmq-hexacore-card {
    position: relative;
    min-height: 118px;

    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 18px;

    padding: 22px;

    border-radius: 18px;

    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.03) 100%);

    border: 1px solid rgba(255, 255, 255, 0.08);

    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);

    overflow: hidden;
  }

  .mmq-card-icon-square {
    position: relative;
    width: 68px;
    height: 68px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mmq-card-icon-square::before,
  .mmq-card-icon-square::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.8;
    pointer-events: none;
  }

  .mmq-card-icon-square::before {
    top: 6px;
    right: 6px;
  }
  .mmq-card-icon-square::after {
    bottom: 6px;
    left: 6px;
  }

  .mmq-card-main-icon {
    width: 44px;
    height: 44px;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  .mmq-card-content {
    flex-grow: 1;
  }

  .mmq-card-title {
    color: #ffffff;
    margin: 0 0 4px 0;
  }

  .mmq-card-desc {
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .mmq-card-corner-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 16px;
    height: 16px;
    object-fit: contain;
    opacity: 0.7;
  }

  .mmq-hexacore-card:hover {
    border-color: rgba(235, 112, 56, 0.3);
    background: linear-gradient(0deg, rgba(103, 103, 115, 0.2), rgba(103, 103, 115, 0.2)),
      linear-gradient(0deg, rgba(235, 112, 56, 0.15), rgba(235, 112, 56, 0.15));
  }
  .mmq-hexacore-card:hover .mmq-card-main-icon {
    filter: invert(57%) sepia(61%) saturate(2371%) hue-rotate(339deg) brightness(101%) contrast(96%);
  }

  .mmq-visuals-background {
    position: relative;
    width: 100%;
    height: 400px;
    margin-top: 40px;
    margin-bottom: -100px;
    z-index: 2;
    pointer-events: none;
  }

  .mmq-ellipse-glow-1 {
    position: absolute;
    width: 300px;
    height: 300px;
    background: #7a3523;
    opacity: 0.5;
    filter: blur(100px);
    border-radius: 50%;
    top: 50%;
    right: 10%;
    transform: translateY(-50%);
  }

  .mmq-ellipse-glow-2 {
    position: absolute;
    width: 250px;
    height: 250px;
    background: #6a6a6a;
    opacity: 0.3;
    filter: blur(100px);
    border-radius: 50%;
    bottom: 0;
    left: 10%;
  }

  .mmq-images-container {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .mmq-img-neon {
    position: absolute;
    height: 110%;
    width: 160%;
    max-width: none;
    object-fit: cover;
    left: -15%;
    bottom: 10%;
    filter: brightness(0.75);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 45%, rgba(0, 0, 0, 0) 80%);
    mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 1) 45%, rgba(0, 0, 0, 0) 80%);
  }

  .mmq-img-champion {
    position: absolute;
    height: 130%;
    width: auto;
    object-fit: contain;
    right: 10%;
    bottom: 0;
  }

  @media screen and (min-width: 1024px) {
    .mmq-section-inner {
      width: 72%;
    }

    .mmq-main-heading-wrapper {
      max-width: 55%;
      margin-bottom: 120px;
    }

    .mmq-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .mmq-hexacore-card {
      padding: 24px 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .mmq-visuals-background {
      position: absolute;
      top: -300px;
      right: -5%;
      width: 75%;
      height: 1100px;
      margin: 0;
    }

    .mmq-images-container {
      bottom: 0;
      right: 0;
    }

    .mmq-img-neon {
      height: 480px;
      width: 700px;
      left: 10%;
      bottom: 330px;
      z-index: 4;
    }

    .mmq-img-champion {
      height: 1100px;
      size: 135%;
      left: 15%;
      bottom: 40px;
    }

    .mmq-ellipse-glow-1 {
      width: 300px;
      height: 300px;
      filter: blur(140px);
      left: 50%;
      top: 40%;
    }

    .mmq-ellipse-glow-2 {
      width: 600px;
      height: 600px;
      filter: blur(110px);
      left: 35%;
      top: 20%;
    }
  }

  .footer-container {
    display: flex;
    align-items: flex-start;
    margin-top: 2rem;
    border-width: 1px 0px 1px 0px;
    border-style: solid;
    border-color: #656a8340;
  }
  .hexacore-image {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .mmq-footer-text {
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Hexacore",
  "tag": "section",
  "class": "section-hexacore",
  "settings": [
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading Line 1 (White)",
      "default": "MEET HEXACORE OUR UNIQUE"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading Line 2 (Gray)",
      "default": "SYSTEM FOR LONG-TERM HEALTH."
    }
  ],
  "blocks": [
    {
      "type": "hexacore",
      "name": "Karta",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "corner_icon",
          "label": "Ikona v pravém rohu",
          "options": [
            { "value": "Frame 179.svg", "label": "Varianta 1" },
            { "value": "Frame 179 (1).svg", "label": "Varianta 2" },
            { "value": "Frame 179 (2).svg", "label": "Varianta 3" },
            { "value": "none", "label": "Bez ikony" }
          ],
          "default": "Frame 179.svg"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Hlavní ikona benefitu"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nadpis karty",
          "default": "BENEFIT"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Popisek karty",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        }
      ]
    },
    {
      "type": "footer",
      "name": "Footer",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Footer text",
          "default": "Hexacore is our unique ecosystem, each section represents part of complex solution for your health"
        }
      ]
    }
  ]
}
{% endschema %}
